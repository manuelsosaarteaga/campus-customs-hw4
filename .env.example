# Copy this file to hw4/.env and fill in real values. hw4/.env is gitignored. Never commit real keys.

# Required: Portkey API key used for the agent's OpenAI calls (gpt-5.6-luna via https://api.portkey.ai/v1)
PORTKEY_API_KEY=pk-your-portkey-key-goes-here

# Optional: secret used to sign login sessions (any long random string). If unset, a random one is
# generated at startup and everyone is logged out when the backend restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: chat model override (default: gpt-5.6-luna)
# CHAT_MODEL=gpt-5.6-luna

# Optional: set to 1 to simulate an AI outage and see the database fallback answers
# CHAT_SIMULATE_OUTAGE=0
